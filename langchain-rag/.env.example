# LLM Configuration
LLM_PROVIDER=openai  # openai, ollama, volcengine
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Volcengine Configuration
VOLCENGINE_API_KEY=your-volcengine-api-key
VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=doubao-pro-4k

# Embedding Configuration
EMBEDDING_PROVIDER=openai  # openai, local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=64

# Reranker Configuration
# local = sentence-transformers CrossEncoder (no API cost, needs the model
#         downloaded on first use); llm = chat-model scoring; none = vector order
RERANKER_PROVIDER=llm
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5
RERANK_THRESHOLD=3.0

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123456
# Max chunks per ingest run sent through entity extraction (one LLM call each)
GRAPH_MAX_CHUNKS=40

# Metadata database (shared with the Spring backend -- keep both pointed at the
# same file so the two backends see the same knowledge bases and sessions)
DB_PATH=../data/rag.db

# Security
# REQUIRED in any real deployment. Use the same value in both backends so their
# tokens are interchangeable. If unset, a random secret is generated per process
# and every token is invalidated on restart.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_HOURS=72
ADMIN_USERNAME=admin
# If unset, a random password is generated and printed in the startup log.
ADMIN_PASSWORD=
# Comma-separated allowed browser origins. Do NOT use `*`: credentials cannot be
# sent with a wildcard origin.
CORS_ORIGINS=http://localhost:3000

# Application Configuration
UPLOAD_DIR=./uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=50
