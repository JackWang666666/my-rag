# Frontend configuration. Copy to .env.local for local development.
#
# Everything here is NEXT_PUBLIC_*, i.e. inlined into the JavaScript bundle at
# build time and readable by anyone who loads the page. Never put a secret here —
# API keys belong in the backends' own environment.

# Where the browser sends requests. These must be reachable from the *browser*,
# not from inside a container: with docker compose the frontend container talks to
# the host's published ports, so "http://spring-ai-rag:8080" would not work here.
NEXT_PUBLIC_SPRING_API_URL=http://localhost:8080
NEXT_PUBLIC_LANGCHAIN_API_URL=http://localhost:8000

# Which backend a first-time visitor talks to: "spring" or "langchain".
# After that the choice lives in localStorage under "rag-preferences" and is
# changed on the Settings page.
NEXT_PUBLIC_DEFAULT_BACKEND=spring
