# ===========================================
# RAG System — docker compose configuration
# ===========================================
#
#   cp .env.example .env      # then edit, at minimum JWT_SECRET and an LLM key
#
# Compose reads this file automatically for every ${...} in docker-compose.yml.
# The infra-only stack (`docker compose up -d`) works without it; the app services
# (`--profile apps`) need at least an LLM key to answer anything.

# --- Security ------------------------------------------------------------
# REQUIRED. Both backends sign tokens with this, so it must be the same value for
# both — leave it empty and each generates its own random secret at startup, after
# which a login on one backend is rejected by the other.
#   openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_HOURS=72

# Bootstrap admin. If ADMIN_PASSWORD is empty, a random one is generated and
# printed once in each backend's startup log — the first backend to start wins,
# since the account lives in the shared database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Browser origins allowed to call the APIs, comma-separated. This is where the
# frontend is served from, not a backend address. Never `*`: credentialed requests
# cannot be sent to a wildcard origin.
CORS_ORIGINS=http://localhost:3000

# --- LLM -----------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
# 换成公司网关时，把网关地址填在这里就行（带 /v1，和 OpenAI SDK 一样）。
# LangChain 需要这个后缀；Spring AI 会自己拼 /v1，所以 Java 端会先把结尾的 /v1
# 去掉，并在启动日志里记一行。
OPENAI_API_BASE=https://api.openai.com/v1
# 只有两端确实要连不同地址时才需要设置；留空则沿用上面的 OPENAI_API_BASE。
SPRING_OPENAI_API_BASE=

# Ollama. host.docker.internal reaches a server running on the host machine.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2:7b

# Volcengine (Python backend only — the Spring backend has no client for it).
VOLCENGINE_API_KEY=
VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=

# --- Embedding -----------------------------------------------------------
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# `local` is Python-only; the Spring backend warns and falls back to openai.
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=64

# --- Reranking -----------------------------------------------------------
# local = sentence-transformers CrossEncoder (Python only), llm = chat-model
# scoring, none = keep the vector-search order.
RERANKER_PROVIDER=llm
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5
RERANK_THRESHOLD=3.0

# --- Milvus --------------------------------------------------------------
# MILVUS_HOST/PORT are fixed to the compose service; these two only matter for a
# managed instance such as Zilliz Cloud.
MILVUS_TOKEN=
MILVUS_DATABASE=default

# --- Neo4j ---------------------------------------------------------------
# Used both to start the neo4j container and to connect to it, so changing the
# password here changes it in one place only if the volume is recreated.
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123456

# --- Ingestion -----------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=50
# Chunks per ingest run sent through entity extraction — one LLM call each, so
# this is the main cost lever when uploading large documents.
GRAPH_MAX_CHUNKS=40

# --- Frontend (build-time) -----------------------------------------------
# NEXT_PUBLIC_* is inlined into the JavaScript bundle when the image is built, so
# changing these needs `docker compose build frontend`, not just a restart. They
# are the URLs the *browser* calls, hence host addresses rather than service names.
NEXT_PUBLIC_SPRING_API_URL=http://localhost:8080
NEXT_PUBLIC_LANGCHAIN_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_BACKEND=spring
